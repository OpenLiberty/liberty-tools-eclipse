				    <groupId>net.bytebuddy</groupId>
				    <artifactId>byte-buddy</artifactId>
				    <version>1.14.18</version>
				    <type>jar</type>
			    </dependency>
			    <dependency>
				    <groupId>org.mockito</groupId>
				    <artifactId>mockito-core</artifactId>
				    <version>5.12.0</version>
				    <type>jar</type>
			    </dependency>
			    <dependency>
				    <groupId>org.mockito</groupId>
				    <artifactId>mockito-junit-jupiter</artifactId>
				    <version>5.12.0</version>
				    <type>jar</type>
			    </dependency>
			    <dependency>
				    <groupId>org.objenesis</groupId>
				    <artifactId>objenesis</artifactId>
				    <version>3.4</version>
				    <type>jar</type>
			    </dependency>
			    <!-- Pin ASM to 9.9.1 to match the Eclipse 2026-06 platform.           -->
                <!-- ta-jam 4.3.2 shades its own ASM internally so it is unaffected.   -->
                <!-- Without this pin, ta-jam's transitive resolution registers         -->
                <!-- org.objectweb.asm 9.10.1 into the shared .p2 pool alongside the   -->
                <!-- platform's 9.9.1, causing a spifly uses-constraint violation that  -->
                <!-- prevents org.eclipse.jface and the entire workbench from loading.  -->
                <dependency>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm</artifactId>
                    <version>9.9.1</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm-analysis</artifactId>
                    <version>9.9.1</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm-commons</artifactId>
                    <version>9.9.1</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm-tree</artifactId>
                    <version>9.9.1</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm-util</artifactId>
                    <version>9.9.1</version>
                    <type>jar</type>
                </dependency>
		    </dependencies>
	    </location>
