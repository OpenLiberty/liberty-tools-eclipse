<server description="Sample Liberty server with Jakarta EE 10">
    <featureManager>
        <feature>restfulWS-3.1</feature>
        <feature>jsonb-3.0</feature>
        <feature>cdi-4.0</feature>
        <feature>servlet-6.0</feature>
    </featureManager>
    
    <httpEndpoint  host="*" httpPort="9080" httpsPort="9443" id="defaultHttpEndpoint" />
    
    <webApplication id="liberty.maven.test.app" location="liberty.maven.test.app.war" name="liberty.maven.test.app"/>
</server>
